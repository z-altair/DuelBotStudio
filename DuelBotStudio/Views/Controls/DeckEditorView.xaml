<UserControl x:Class="DuelBotStudio.Views.Controls.DeckEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">
        <TextBlock Text="Card Search" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="SearchInputTextBox" Height="28" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
        <Button Content="Search Card" Height="30" Margin="0,0,0,15" Click="onSearchButtonClick"/>
        <TextBlock Text="Search Results" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
        <ListBox x:Name="SearchResultsListBox"
                 Height="380"
                 Background="#1E1E1E"
                 Foreground="White"
                 DisplayMemberPath="name"
                 PreviewMouseRightButtonUp="onSearchResultRightClick"/>
    </StackPanel>
</UserControl>
