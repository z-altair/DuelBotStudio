<UserControl x:Class="DuelBotStudio.Views.Controls.BotGroupEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1E1E1E" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#252526" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Reusable card groups" Foreground="White"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Build reusable collections such as Starters, Extenders or Negations."
                               Foreground="#AAAAAA" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="New group" Width="100" Margin="0,0,6,0"
                            Click="OnNewGroupClick"/>
                    <Button Content="Open library" Width="105" Margin="0,0,6,0"
                            Click="OnOpenClick"/>
                    <Button Content="Save library" Width="105" Click="OnSaveClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#252526" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Your groups" Foreground="White"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                             Background="#1E1E1E" Foreground="#DDDDDD"
                             MouseDoubleClick="OnGroupDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="5" Margin="0,0,0,5" Background="#2D2D30">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding CardIds.Count, StringFormat={}{0} cards}"
                                                   Foreground="#AAAAAA" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button DockPanel.Dock="Bottom" Content="Remove selected group"
                            Width="155" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OnRemoveGroupClick"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="#252526" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="20" FontWeight="Bold" Background="#1E1E1E"
                             Foreground="White" Padding="5"/>
                    <TextBox Grid.Row="1" Text="{Binding SelectedGroup.Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                             Margin="0,8,0,10" Background="#1E1E1E" Foreground="#DDDDDD"
                             ToolTip="Describe what this group is used for"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding GroupCards}"
                                 SelectedItem="{Binding SelectedGroupCard}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="150" Margin="0,0,10,10" Background="#1E1E1E">
                                        <StackPanel>
                                            <Image Source="{Binding ImageUrl}" Height="210" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       TextWrapping="Wrap" Margin="5"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Background="#1E1E1E" Foreground="White"
                                     KeyDown="OnSearchKeyDown"/>
                            <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedCard}"
                                     Height="100" Background="#1E1E1E" Foreground="#DDDDDD"
                                     DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Button Content="Search" Width="90" Click="OnSearchClick"/>
                            <Button Content="Add card" Width="90" Margin="0,6,0,0"
                                    Click="OnAddCardClick"/>
                            <Button Content="Remove card" Width="90" Margin="0,6,0,0"
                                    Click="OnRemoveCardClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#FFB870"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
