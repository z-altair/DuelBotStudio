<Window x:Class="DuelBotStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DuelBotStudio.Views.Controls"
        Title="{Binding WindowTitle}" Height="720" Width="1280"
        Background="#1E1E1E"
        Closing="OnWindowClosing">
    <TabControl Background="#1E1E1E" BorderThickness="0">
        <TabItem Header="Deck tools">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <controls:CardDetailsView x:Name="CardDetailsControl" Grid.Column="0" Margin="5"/>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

                <controls:DeckViewerView x:Name="DeckViewerControl" Grid.Column="2" Margin="5"/>

                <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

                <controls:DeckEditorView x:Name="DeckEditorControl" Grid.Column="4" Margin="5"/>
            </Grid>
        </TabItem>
        <TabItem Header="Bot editor">
            <controls:BotEditorView x:Name="BotEditorControl"/>
        </TabItem>
        <TabItem Header="Group editor">
            <controls:BotGroupEditorView x:Name="BotGroupEditorControl"/>
        </TabItem>
    </TabControl>
</Window>
