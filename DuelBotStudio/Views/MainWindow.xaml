<Window x:Class="DuelBotStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DuelBotStudio.Views.Controls"
        Title="DuelBot Studio" Height="720" Width="1280"
        Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <controls:CardDetailsView x:Name="CardDetailsControl" Grid.Column="0" Margin="5"/>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

        <controls:DeckViewerView x:Name="DeckViewerControl" Grid.Column="2" Margin="5"/>

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

        <TabControl Grid.Column="4" Background="#252526" BorderThickness="0" Margin="5">
            <TabItem Header="Deck Editor">
                <controls:DeckEditorView x:Name="DeckEditorControl"/>
            </TabItem>
            <TabItem Header="Bot Logic">
                <controls:BotEditorView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
