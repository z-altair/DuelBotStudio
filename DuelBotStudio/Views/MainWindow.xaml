<Window x:Class="DuelBotStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DuelBot Studio" Height="720" Width="1280"
        Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Selected Card Detail Panel -->
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="5"/>
            <!-- Column 1: Main Deck Viewer -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <!-- Column 2: Workspace Tabs (Deck / Bot Logic) -->
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Selected Card Details -->
        <Border Grid.Column="0" Background="#252526" Margin="5" Padding="10" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Card Details" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Image x:Name="SelectedCardImage" Height="320" Stretch="Uniform" Margin="0,0,0,10"/>

                    <TextBlock x:Name="SelectedCardName" Foreground="#FFD700" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <TextBlock x:Name="SelectedCardType" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="SelectedCardStats" Foreground="#00FF7F" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="SelectedCardDescription" Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- SPLITTER 1 -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

        <!-- MIDDLE COLUMN: Deck Viewer -->
        <Grid Grid.Column="2" Margin="5">
            <DockPanel>
                <Button Content="Load Deck (.ydk)" 
                        DockPanel.Dock="Top" 
                        Height="35" 
                        Margin="0,0,0,10" 
                        Click="onLoadDeckButtonClick"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Main Deck Section -->
                        <TextBlock x:Name="MainDeckHeader" Text="Main Deck (0)" Foreground="White" FontSize="16" FontWeight="Bold" Margin="5,5,5,5"/>
                        <WrapPanel x:Name="MainDeckPanel" Margin="0,0,0,15"/>

                        <Separator Background="#3E3E42" Margin="0,5"/>

                        <!-- Extra Deck Section -->
                        <TextBlock x:Name="ExtraDeckHeader" Text="Extra Deck (0)" Foreground="White" FontSize="16" FontWeight="Bold" Margin="5,5,5,5"/>
                        <WrapPanel x:Name="ExtraDeckPanel" Margin="0,0,0,15"/>

                        <Separator Background="#3E3E42" Margin="0,5"/>

                        <!-- Side Deck Section -->
                        <TextBlock x:Name="SideDeckHeader" Text="Side Deck (0)" Foreground="White" FontSize="16" FontWeight="Bold" Margin="5,5,5,5"/>
                        <WrapPanel x:Name="SideDeckPanel" Margin="0,0,0,15"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- SPLITTER 2 -->
        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

        <!-- RIGHT COLUMN: Workspace Modes -->
        <TabControl Grid.Column="4" Background="#252526" BorderThickness="0" Margin="5">

            <!-- Tab 1: Deck Editor -->
            <TabItem Header="Deck Editor">
                <StackPanel Margin="10">
                    <TextBlock Text="Card Search" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="SearchInputTextBox" Height="28" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
                    <Button Content="Search Card" 
                            Height="30" 
                            Margin="0,0,0,15"
                            Click="onSearchButtonClick"/>

                    <TextBlock Text="Search Results" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>

                    <ListBox x:Name="SearchResultsListBox" 
                            Height="380" 
                            Background="#1E1E1E" 
                            Foreground="White"
                            PreviewMouseRightButtonUp="onSearchResultRightClick"/>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: Bot Logic Editor -->
            <TabItem Header="Bot Logic">
                <StackPanel Margin="10">
                    <TextBlock Text="Execution Rules" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Content="+ Add Rule For Selected Card" Height="30" Margin="0,0,0,10"/>
                    <ListBox x:Name="BotRulesListBox" Height="400" Background="#1E1E1E" Foreground="White"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>